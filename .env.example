# --- Server secrets -----------------------------------------------------------
# 32 bytes, generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Required by scripts/add-member.ts as a guard so the seeding script cannot be
# run without deliberate operator intent. Generate with: openssl rand -base64 32
MCP_ADMIN_TOKEN=

# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/refresh-tokens. Set the same value in Vercel project env vars.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Meta app (Development mode, Instagram testers) ---------------------------
IG_APP_ID=
IG_APP_SECRET=

# --- Supabase (DEDICATED project, service role) -------------------------------
# Use a Supabase project that hosts ONLY this Instagram MCP server. Do not point
# it at a project shared with another app — team_members/posts are generic names
# and this server's service-role client has full table access. Run the migration
# in supabase/migrations/ against this project.
#
# Media images are stored in Supabase Storage (bucket: instagram-media, public).
# No separate object storage service is needed.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# NOTE: No Instagram user tokens live in the environment. They are stored
# AES-256-GCM encrypted in the team_members table.
